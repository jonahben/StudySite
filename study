// ADMIN PANEL
function buildAdminPanel(id){
  const has=qBanks[id]&&qBanks[id].length>0;
  return `<div class="admin-panel">
    <div class="admin-title">🔐 Admin — ${SUBJECTS[id].name} ${has?'<span style="font-size:12px;color:var(--teal);font-family:var(--fb)">✓ '+qBanks[id].length+' questions loaded</span>':''}</div>
    <div class="form-row"><label>Paste your class notes / unit content</label><textarea id="admin-notes-${id}" rows="6" placeholder="Paste your notes, textbook extracts, teacher handouts — anything you've covered in this unit. The more detail, the better the questions.">${qBanks[id+'_src']||''}</textarea></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn btn-orange" onclick="generateQuestions('${id}')">⚡ Generate 40 questions with AI</button>
      ${has?`<button class="btn btn-red btn-sm" onclick="clearBank('${id}')">🗑 Clear bank</button>`:''}
      <span style="font-size:11px;color:var(--fa)">Students get 20 random questions per attempt</span>
    </div>
    <div id="gen-status-${id}" class="gen-status"></div>
    ${has?`<div class="qb-preview">${qBanks[id].slice(0,4).map((q,i)=>`<div class="qb-item"><strong>Q${i+1}: ${q.q}</strong>Answer: ${q.opts[q.ans]}</div>`).join('')}<div class="qb-item" style="text-align:center;color:var(--fa);font-size:11px">+ ${qBanks[id].length-4} more questions</div></div>`:''}
  </div>`;
}
async function generateQuestions(id){
  const notes=document.getElementById(`admin-notes-${id}`).value.trim();
  if(!notes||notes.length<80){alert('Please paste at least a paragraph of notes first.');return;}
  const st=document.getElementById(`gen-status-${id}`);
  st.className='gen-status loading';st.style.display='block';
  st.innerHTML='<span class="spinner"></span>Generating 40 questions — this takes about 15 seconds…';
  try{
    const prompt=`You are an expert teacher creating exam questions for ${SUBJECTS[id].name}. From the study notes below, generate exactly 40 multiple choice questions.

STRICT RULES:
- Base questions ONLY on the provided notes
- Each question has exactly 4 options
- Only one option is correct
- Mix difficulty: ~10 easy, ~20 medium, ~10 hard
- Test genuine understanding, not just memorisation
- Wrong answers must be plausible — not obviously wrong
- Never make the correct answer stand out by length

Return ONLY a raw JSON array, no markdown, no explanation:
[{"q":"Question?","opts":["A","B","C","D"],"ans":0},...]
(ans = 0-based index of correct option)

STUDY NOTES:
${notes}`;
    const resp=await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json','anthropic-dangerous-direct-browser-access':'true'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:8000,messages:[{role:'user',content:prompt}]})});
    const data=await resp.json();
    if(data.error)throw new Error(data.error.message);
    let txt=data.content.map(c=>c.text||'').join('').replace(/```json|```/g,'').trim();
    const qs=JSON.parse(txt);
    if(!Array.isArray(qs)||qs.length<5)throw new Error('Too few questions returned');
    qBanks[id]=qs.slice(0,40);qBanks[id+'_src']=notes;
    localStorage.setItem('sh_qbanks',JSON.stringify(qBanks));
    st.className='gen-status done';
    st.innerHTML=`✓ ${qBanks[id].length} questions generated and locked! Students will get 20 random questions per attempt.`;
    setTimeout(()=>rebuildAll(),1800);
  }catch(e){st.className='gen-status error';st.innerHTML='✗ Error: '+e.message+'. Check your notes and try again.';}
}
function clearBank(id){if(!confirm('Clear question bank for '+SUBJECTS[id].name+'?'))return;delete qBanks[id];delete qBanks[id+'_src'];localStorage.setItem('sh_qbanks',JSON.stringify(qBanks));rebuildAll();}

// FLASHCARDS
function buildFC(id,s){
  return `<div class="fc-layout">
    <div>
      <div class="flip-scene" onclick="fcFlip('${id}')">
        <div class="flip-inner" id="fc-inner-${id}">
          <div class="flip-face"><div class="flip-lbl">Question — click to flip</div><div class="flip-txt" id="fc-front-${id}"></div></div>
          <div class="flip-face flip-back"><div class="flip-lbl">Answer</div><div class="flip-txt" id="fc-back-${id}"></div></div>
        </div>
      </div>
      <p class="flip-hint">Click the card to reveal the answer</p>
      <div class="fc-ctrl">
        <button class="icon-btn" onclick="fcPrev('${id}')">←</button>
        <span class="fc-count" id="fc-count-${id}">0/0</span>
        <button class="icon-btn" onclick="fcNext('${id}')">→</button>
        <button class="btn btn-sm" onclick="fcShuffle('${id}')" style="margin-left:8px">⇄ Shuffle</button>
      </div>
      <hr class="divider"/>
      <p style="font-size:12px;font-weight:600;color:var(--mu);margin-bottom:10px">Add your own card</p>
      <div class="form-row"><label>Question</label><input type="text" id="fc-q-${id}" placeholder="e.g. What is…"/></div>
      <div class="form-row"><label>Answer</label><textarea id="fc-a-${id}" rows="2" placeholder="The answer…"></textarea></div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-lime" onclick="fcAdd('${id}')">+ Add card</button>
        ${isAdmin?`<button class="btn btn-red btn-sm" onclick="fcClearCustom('${id}')">Clear custom cards</button>`:''}
      </div>
    </div>
    <div class="fc-deck"><div class="deck-label">Deck</div><div class="deck-list" id="fc-list-${id}"></div></div>
  </div>`;
}
function initFC(id,s){const custom=fcDecks[id]||[];fcState[id]={cards:[...s.defaultCards,...custom],idx:0,flipped:false};fcRender(id);}
function fcRender(id){
  const st=fcState[id];if(!st||!st.cards.length)return;
  const c=st.cards[st.idx];
  const fi=document.getElementById('fc-inner-'+id);if(fi)fi.classList.remove('flipped');st.flipped=false;
  const ff=document.getElementById('fc-front-'+id);if(ff)ff.textContent=c.q;
  const fb=document.getElementById('fc-back-'+id);if(fb)fb.textContent=c.a;
  const fc=document.getElementById('fc-count-'+id);if(fc)fc.textContent=(st.idx+1)+'/'+st.cards.length;
  const fl=document.getElementById('fc-list-'+id);
  if(fl){fl.innerHTML='';st.cards.forEach((card,i)=>{const el=document.createElement('div');el.className='deck-item'+(i===st.idx?' active':'');el.textContent=card.q.length>42?card.q.slice(0,42)+'…':card.q;el.onclick=()=>{fcState[id].idx=i;fcRender(id);};fl.appendChild(el);});}
}
function fcFlip(id){const st=fcState[id];st.flipped=!st.flipped;const fi=document.getElementById('fc-inner-'+id);if(fi)fi.classList.toggle('flipped',st.flipped);}
function fcNext(id){const st=fcState[id];st.idx=(st.idx+1)%st.cards.length;fcRender(id);}
function fcPrev(id){const st=fcState[id];st.idx=(st.idx-1+st.cards.length)%st.cards.length;fcRender(id);}
function fcShuffle(id){const c=fcState[id].cards;for(let i=c.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[c[i],c[j]]=[c[j],c[i]];}fcState[id].idx=0;fcRender(id);}
function fcAdd(id){
  const q=document.getElementById('fc-q-'+id).value.trim(),a=document.getElementById('fc-a-'+id).value.trim();
  if(!q||!a){alert('Fill in both question and answer.');return;}
  if(!fcDecks[id])fcDecks[id]=[];fcDecks[id].push({q,a});localStorage.setItem('sh_fcdecks',JSON.stringify(fcDecks));
  document.getElementById('fc-q-'+id).value='';document.getElementById('fc-a-'+id).value='';
  fcState[id].cards.push({q,a});fcState[id].idx=fcState[id].cards.length-1;fcRender(id);
}
function fcClearCustom(id){if(!confirm('Clear custom cards for '+SUBJECTS[id].name+'?'))return;delete fcDecks[id];localStorage.setItem('sh_fcdecks',JSON.stringify(fcDecks));initFC(id,SUBJECTS[id]);}

// QUIZ
function buildQuizPane(id){
  const has=qBanks[id]&&qBanks[id].length>0;
  if(!has)return `<div class="no-quiz"><span class="no-quiz-icon">🤖</span><h3>No quiz yet</h3><p>${isAdmin?'Use the Admin panel above — paste your class notes and click "Generate 40 questions with AI".':'The quiz for this class hasn\'t been set up yet. Check back soon!'}</p><p style="font-size:12px;color:var(--fa)">Once set up, everyone gets 20 random questions from a bank of 40, with a 30-second timer per question.</p></div>`;
  return `<div id="quiz-wrap-${id}"></div>`;
}
function initQuizPane(id){if(qBanks[id]&&qBanks[id].length>0)startQuiz(id);}
function startQuiz(id){
  const bank=qBanks[id];if(!bank||!bank.length)return;
  const qs=[...bank].sort(()=>Math.random()-0.5).slice(0,20);
  qState[id]={qs,idx:0,correct:0,wrong:0,answered:false,timerVal:Q_TIME,timerInt:null};renderQ(id);
}
function renderQ(id){
  const wrap=document.getElementById('quiz-wrap-'+id);if(!wrap)return;
  const st=qState[id];const q=st.qs[st.idx];
  wrap.innerHTML=`<div class="quiz-layout">
    <div>
      <div class="q-prog-wrap"><div class="q-prog" id="qprog-${id}" style="width:${st.idx/st.qs.length*100}%"></div></div>
      <div class="q-timer-bar-wrap"><div class="q-timer-bar" id="qtbar-${id}" style="width:100%"></div></div>
      <div class="q-meta"><span class="q-num">Question ${st.idx+1} of ${st.qs.length}</span><span class="q-timer-num" id="qtnum-${id}">${Q_TIME}s</span></div>
      <div class="q-question">${q.q}</div>
      <div class="q-opts">${q.opts.map((o,i)=>`<button class="q-opt" onclick="qAnswer('${id}',${i},${q.ans},this)"><span class="q-opt-l">${Q_LETTERS[i]}</span>${o}</button>`).join('')}</div>
      <div class="q-feedback" id="qfb-${id}"></div>
      <button class="btn btn-lime" id="qnext-${id}" onclick="qNext('${id}')" style="display:none">Next question →</button>
    </div>
    <div class="score-panel">
      <div class="score-big"><span class="score-pct" id="qpct-${id}">${st.correct+st.wrong>0?Math.round(st.correct/(st.correct+st.wrong)*100)+'%':'—'}</span><span class="score-lbl">accuracy so far</span></div>
      <div class="score-mini"><div class="score-box"><span class="n c-n" id="qc-${id}">${st.correct}</span><span class="l">Correct</span></div><div class="score-box"><span class="n w-n" id="qw-${id}">${st.wrong}</span><span class="l">Wrong</span></div></div>
      <button class="btn btn-sm btn-block" onclick="startQuiz('${id}')">↺ Restart</button>
    </div>
  </div>`;
  startQTimer(id);
}
function startQTimer(id){
  const st=qState[id];if(st.timerInt)clearInterval(st.timerInt);st.timerVal=Q_TIME;
  st.timerInt=setInterval(()=>{
    st.timerVal--;
    const bar=document.getElementById('qtbar-'+id),num=document.getElementById('qtnum-'+id);
    if(!bar||!num){clearInterval(st.timerInt);return;}
    bar.style.width=(st.timerVal/Q_TIME*100)+'%';num.textContent=st.timerVal+'s';
    if(st.timerVal<=10){bar.className='q-timer-bar warn';num.className='q-timer-num warn';}
    if(st.timerVal<=5){bar.className='q-timer-bar danger';num.className='q-timer-num danger';}
    if(st.timerVal<=0){clearInterval(st.timerInt);if(!st.answered)qTimeOut(id);}
  },1000);
}
function qTimeOut(id){
  const st=qState[id];st.answered=true;st.wrong++;
  document.querySelectorAll(`#quiz-wrap-${id} .q-opt`).forEach(b=>b.disabled=true);
  const correct=st.qs[st.idx].ans;
  document.querySelectorAll(`#quiz-wrap-${id} .q-opt`)[correct].classList.add('correct');
  const fb=document.getElementById('qfb-'+id);if(fb){fb.className='q-feedback bad';fb.style.display='block';fb.textContent='⏱ Time\'s up! Correct answer: '+st.qs[st.idx].opts[correct];}
  const nx=document.getElementById('qnext-'+id);if(nx)nx.style.display='inline-flex';updateQUI(id);
}
function qAnswer(id,chosen,correct,el){
  const st=qState[id];if(st.answered)return;st.answered=true;clearInterval(st.timerInt);
  document.querySelectorAll(`#quiz-wrap-${id} .q-opt`).forEach(b=>b.disabled=true);
  const fb=document.getElementById('qfb-'+id);
  if(chosen===correct){el.classList.add('correct');st.correct++;if(fb){fb.className='q-feedback ok';fb.style.display='block';fb.textContent='✓ Correct!';}}
  else{el.classList.add('wrong');document.querySelectorAll(`#quiz-wrap-${id} .q-opt`)[correct].classList.add('correct');st.wrong++;if(fb){fb.className='q-feedback bad';fb.style.display='block';fb.textContent='✗ Incorrect — correct answer: '+st.qs[st.idx].opts[correct];}}
  const nx=document.getElementById('qnext-'+id);if(nx)nx.style.display='inline-flex';updateQUI(id);
}
function updateQUI(id){
  const st=qState[id];const tot=st.correct+st.wrong;const pct=tot?Math.round(st.correct/tot*100):0;
  const pe=document.getElementById('qpct-'+id);if(pe)pe.textContent=pct+'%';
  const ce=document.getElementById('qc-'+id);if(ce)ce.textContent=st.correct;
  const we=document.getElementById('qw-'+id);if(we)we.textContent=st.wrong;
}
function qNext(id){const st=qState[id];st.idx++;st.answered=false;if(st.idx>=st.qs.length){showResult(id);return;}renderQ(id);}
function showResult(id){
  clearInterval(qState[id].timerInt);
  const st=qState[id];const tot=st.correct+st.wrong;const pct=tot?Math.round(st.correct/tot*100):0;
  let grade,gc,msg;
  if(pct>=90){grade='A+';gc='var(--lime)';msg='Outstanding! Top of the class 🏆';}
  else if(pct>=80){grade='A';gc='var(--lime)';msg='Excellent work! 🌟';}
  else if(pct>=70){grade='B';gc='var(--teal)';msg='Great job — you know your stuff 💪';}
  else if(pct>=60){grade='C';gc='var(--blue)';msg='Good effort — review the ones you missed 📖';}
  else if(pct>=50){grade='D';gc='var(--orange)';msg='Keep going — you\'re getting there 📚';}
  else{grade='F';gc='var(--red)';msg='Don\'t give up — review your notes and retry! 🔁';}
  if(currentUser){scores.push({user:currentUser,subject:id,subjectName:SUBJECTS[id].name,score:pct,correct:st.correct,total:tot,date:new Date().toLocaleDateString('en-GB'),time:Date.now()});localStorage.setItem('sh_scores',JSON.stringify(scores));}
  const wrap=document.getElementById('quiz-wrap-'+id);if(!wrap)return;
  wrap.innerHTML=`<div class="result-screen">
    <div class="result-score" style="color:${gc}">${pct}%</div>
    <span class="result-grade" style="background:${gc}22;color:${gc};border:1px solid ${gc}44">${grade}</span>
    <p class="result-msg">${msg}${currentUser?'<br><span style="font-size:12px;color:var(--fa)">Saved as <strong style="color:var(--lime)">${currentUser}</strong></span>':' <span style="font-size:12px;color:var(--fa)">(Set a username to save your score!)</span>'}</p>
    <div class="result-breakdown">
      <div class="rb-item"><span class="rb-n" style="color:var(--teal)">${st.correct}</span><span class="rb-l">Correct</span></div>
      <div class="rb-item"><span class="rb-n" style="color:var(--red)">${st.wrong}</span><span class="rb-l">Wrong</span></div>
      <div class="rb-item"><span class="rb-n" style="color:var(--lime)">${tot}</span><span class="rb-l">Total</span></div>
    </div>
    <div class="result-btns">
      <button class="btn btn-lime btn-lg" onclick="startQuiz('${id}')">↺ Try again</button>
      <button class="btn btn-lg" onclick="showPage('leaderboard')">🏆 Leaderboard</button>
      <button class="btn btn-lg" onclick="switchTab('${id}','flashcards')">🃏 Flashcards</button>
    </div>
  </div>`;
}

// NOTES
function buildNotesPane(id){
  return `<div class="notes-layout">
    <div>
      <div class="n-toolbar">
        <button class="n-tb-btn" onclick="nWrap('${id}','**','**')"><b>B</b></button>
        <button class="n-tb-btn" onclick="nWrap('${id}','*','*')"><i>I</i></button>
        <button class="n-tb-btn" onclick="nInsert('${id}','# ')">H1</button>
        <button class="n-tb-btn" onclick="nInsert('${id}','## ')">H2</button>
        <button class="n-tb-btn" onclick="nInsert('${id}','- ')">• List</button>
        <button class="n-tb-btn" onclick="nInsert('${id}','1. ')">1. List</button>
        <button class="n-tb-btn" onclick="nInsert('${id}','> ')">Quote</button>
        <button class="n-tb-btn" style="margin-left:auto;color:var(--lime)" onclick="nSave('${id}')">💾 Save</button>
        <button class="n-tb-btn" onclick="nClear('${id}')">🗑</button>
      </div>
      <textarea class="n-ta" id="n-ta-${id}" placeholder="Write your ${SUBJECTS[id].name} notes here…&#10;&#10;# Heading  ## Subheading  - Bullet  **Bold**  *Italic*" oninput="nMeta('${id}')"></textarea>
      <p class="n-meta" id="n-meta-${id}">0 words · 0 characters</p>
    </div>
    <div>
      <p style="font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--fa);margin-bottom:8px">Saved notes</p>
      <div id="n-saved-${id}"></div>
      <p id="n-empty-${id}" style="font-size:12px;color:var(--fa)">No saved notes yet</p>
    </div>
  </div>`;
}
function nWrap(id,a,b){const ta=document.getElementById('n-ta-'+id);const s=ta.selectionStart,e=ta.selectionEnd,v=ta.value;ta.value=v.slice(0,s)+a+v.slice(s,e)+b+v.slice(e);ta.focus();ta.setSelectionRange(s+a.length,e+a.length);nMeta(id);}
function nInsert(id,txt){const ta=document.getElementById('n-ta-'+id);const s=ta.selectionStart,v=ta.value,ls=v.lastIndexOf('\n',s-1)+1;ta.value=v.slice(0,ls)+txt+v.slice(ls);ta.focus();nMeta(id);}
function nMeta(id){const v=document.getElementById('n-ta-'+id).value;const w=v.trim()?v.trim().split(/\s+/).length:0;document.getElementById('n-meta-'+id).textContent=w+' words · '+v.length+' chars';}
function nSave(id){const txt=document.getElementById('n-ta-'+id).value.trim();if(!txt)return;if(!notesData[id])notesData[id]=[];notesData[id].unshift({title:txt.split('\n')[0].replace(/[#*>_-]/g,'').trim().slice(0,40)||'Note',body:txt,date:new Date().toLocaleDateString('en-GB')});localStorage.setItem('sh_notes',JSON.stringify(notesData));renderSavedNotes(id);}
function nClear(id){if(confirm('Clear the editor?')){document.getElementById('n-ta-'+id).value='';nMeta(id);}}
function renderSavedNotes(id){const list=document.getElementById('n-saved-'+id);const empty=document.getElementById('n-empty-'+id);if(!list)return;const notes=notesData[id]||[];if(empty)empty.style.display=notes.length?'none':'block';list.innerHTML=notes.map((n,i)=>`<div class="n-saved-item" onclick="loadNote('${id}',${i})"><div class="n-saved-title">${n.title}</div><div class="n-saved-date">${n.date}</div></div>`).join('');}
function loadNote(id,i){const n=notesData[id][i];if(!n)return;const ta=document.getElementById('n-ta-'+id);if(ta){ta.value=n.body;nMeta(id);}}

