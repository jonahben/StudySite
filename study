      <div class="mode-row">
        <button class="mode-btn active" id="tm-f-${id}" onclick="tmMode('${id}','focus',25,this)">Focus 25m</button>
        <button class="mode-btn" id="tm-s-${id}" onclick="tmMode('${id}','short',5,this)">Break 5m</button>
        <button class="mode-btn" id="tm-l-${id}" onclick="tmMode('${id}','long',15,this)">Long 15m</button>
      </div>
      <div class="timer-face">
        <svg class="t-svg" viewBox="0 0 100 100"><circle class="t-bg" cx="50" cy="50" r="45"/><circle class="t-ring" id="tring-${id}" cx="50" cy="50" r="45" stroke-dasharray="${TCIRC}" stroke-dashoffset="0"/></svg>
        <span class="t-num" id="tnum-${id}">25:00</span>
      </div>
      <div class="t-btns">
        <button class="t-main-btn" id="tbtn-${id}" onclick="tmToggle('${id}')">▶ Start</button>
        <button class="t-reset-btn" onclick="tmReset('${id}')">↺</button>
      </div>
      <div class="t-pips" id="tpips-${id}"><div class="t-pip"></div><div class="t-pip"></div><div class="t-pip"></div><div class="t-pip"></div></div>
    </div>
    <div>
      <div class="card2" style="margin-bottom:10px">
        <p style="font-size:11px;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;color:var(--mu);margin-bottom:10px">Today's sessions</p>
        <div class="t-stats"><div class="t-stat"><span class="t-stat-n" id="tsess-${id}">0</span><span class="t-stat-l">Sessions</span></div><div class="t-stat"><span class="t-stat-n" id="tmins-${id}">0m</span><span class="t-stat-l">Focus time</span></div></div>
      </div>
      <div class="card2"><p style="font-size:13px;line-height:1.7;color:var(--mu)"><strong style="color:var(--tx)">🍅 The Pomodoro Technique</strong><br>Work for <strong style="color:var(--lime)">25 minutes</strong> with zero distractions, then take a <strong style="color:var(--teal)">5-minute break</strong>. After 4 sessions, take a <strong style="color:var(--blue)">15-minute long break</strong>.<br><br>Your brain retains information better with structured rest. Use this while doing flashcards or reviewing notes!</p></div>
    </div>
  </div>`;
}
function initTimer(id){tmState[id]={mode:'focus',total:25*60,remaining:25*60,running:false,sessions:0,mins:0};tmUI(id);}
function tmFmt(s){return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')}
function tmUI(id){const st=tmState[id];const n=document.getElementById('tnum-'+id);if(n)n.textContent=tmFmt(st.remaining);const r=document.getElementById('tring-'+id);if(r)r.style.strokeDashoffset=TCIRC*(1-st.remaining/st.total);}
function tmMode(id,mode,mins,btn){if(tmIntervals[id])clearInterval(tmIntervals[id]);const st=tmState[id];st.mode=mode;st.total=mins*60;st.remaining=mins*60;st.running=false;[`tm-f-${id}`,`tm-s-${id}`,`tm-l-${id}`].forEach(i=>{const e=document.getElementById(i);if(e)e.classList.remove('active');});if(btn)btn.classList.add('active');const b=document.getElementById('tbtn-'+id);if(b)b.textContent='▶ Start';tmUI(id);}
function tmToggle(id){
  const st=tmState[id];
  if(st.running){clearInterval(tmIntervals[id]);st.running=false;const b=document.getElementById('tbtn-'+id);if(b)b.textContent='▶ Resume';}
  else{st.running=true;const b=document.getElementById('tbtn-'+id);if(b)b.textContent='⏸ Pause';
    tmIntervals[id]=setInterval(()=>{st.remaining--;tmUI(id);
      if(st.remaining<=0){clearInterval(tmIntervals[id]);st.running=false;if(st.mode==='focus'){st.sessions=Math.min(st.sessions+1,8);st.mins+=25;tmRenderPips(id);const s=document.getElementById('tsess-'+id);if(s)s.textContent=st.sessions;const m=document.getElementById('tmins-'+id);if(m)m.textContent=st.mins+'m';}st.remaining=st.total;const b=document.getElementById('tbtn-'+id);if(b)b.textContent='▶ Start';tmUI(id);}
    },1000);}
}
function tmReset(id){if(tmIntervals[id])clearInterval(tmIntervals[id]);const st=tmState[id];st.running=false;st.remaining=st.total;const b=document.getElementById('tbtn-'+id);if(b)b.textContent='▶ Start';tmUI(id);}
function tmRenderPips(id){const pips=document.querySelectorAll(`#tpips-${id} .t-pip`);pips.forEach((p,i)=>p.classList.toggle('done',i<tmState[id].sessions));}

// LEADERBOARD
function filterLB(f,btn){lbSubjFilter=f;document.querySelectorAll('.lb-f-btn').forEach(b=>b.classList.remove('active'));if(btn)btn.classList.add('active');renderLB();}
function renderLB(){
  const body=document.getElementById('lbBody'),empty=document.getElementById('lbEmpty');if(!body)return;
  let data=[...scores];if(lbSubjFilter!=='all')data=data.filter(s=>s.subject===lbSubjFilter);
  const best={};data.forEach(s=>{const k=s.user+'|'+s.subject;if(!best[k]||s.score>best[k].score||(s.score===best[k].score&&s.time<best[k].time))best[k]=s;});
  const sorted=Object.values(best).sort((a,b)=>b.score-a.score||(a.time||0)-(b.time||0));
  if(!sorted.length){body.innerHTML='';if(empty)empty.style.display='block';return;}
  if(empty)empty.style.display='none';
  const SC={geometry:'#4f8fff',algebra2:'#9f6fff',worldciv2:'#ff8c42',english10:'#2fffc8',science10:'#ff4f4f',french4:'#d4f14a'};
  body.innerHTML=sorted.map((s,i)=>{const isYou=s.user===currentUser;const rc=i===0?'g':i===1?'s':i===2?'b':'';const c=SC[s.subject]||'var(--mu)';return `<tr class="${isYou?'you-row':''}"><td><span class="rank-num ${rc}">${i+1}</span></td><td><strong>${s.user}</strong>${isYou?' <span style="font-size:10px;opacity:0.6">(you)</span>':''}</td><td><span class="s-chip" style="background:${c}18;color:${c};border:1px solid ${c}33">${s.subjectName}</span></td><td><strong>${s.score}%</strong></td><td style="color:var(--mu)">${s.correct}/${s.total}</td><td style="color:var(--fa);font-size:12px">${s.date}</td></tr>`;}).join('');
}

// FILES
function handleUpload(input){Array.from(input.files).forEach(f=>{uploadedFiles.unshift({name:f.name,size:f.size,date:new Date().toLocaleDateString('en-GB')});});localStorage.setItem('sh_files',JSON.stringify(uploadedFiles));renderFiles();}
function renderFiles(){
  const list=document.getElementById('fileList'),empty=document.getElementById('noFiles');if(!list)return;
  if(!uploadedFiles.length){list.innerHTML='';if(empty)empty.style.display='block';return;}if(empty)empty.style.display='none';
  const icons={pdf:'📄',doc:'📝',docx:'📝',txt:'📃',png:'🖼️',jpg:'🖼️',jpeg:'🖼️',pptx:'📊',ppt:'📊'};
  list.innerHTML=uploadedFiles.map((f,i)=>{const ext=f.name.split('.').pop().toLowerCase();const sz=f.size>1048576?(f.size/1048576).toFixed(1)+'MB':(f.size/1024).toFixed(0)+'KB';return `<div class="file-item"><span style="font-size:1.4rem">${icons[ext]||'📎'}</span><span style="flex:1;font-size:13px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${f.name}</span><span style="font-size:11px;color:var(--mu);flex-shrink:0">${sz}</span><span style="font-size:11px;color:var(--fa);flex-shrink:0;margin-left:8px">${f.date}</span><button class="file-del" onclick="deleteFile(${i})">×</button></div>`;}).join('');
}
function deleteFile(i){uploadedFiles.splice(i,1);localStorage.setItem('sh_files',JSON.stringify(uploadedFiles));renderFiles();}

// INIT
rebuildAll();
</script>
