    <div class="logo" onclick="showPage('home')">Study<span>Hub</span></div>
    <button class="admin-btn" id="adminBtn" onclick="toggleAdmin()">🔐 <span id="adminBtnTxt">Admin</span></button>
    <div class="hdr-pill" onclick="document.getElementById('userOverlay').classList.remove('hidden')">
      <div class="avatar" id="hdrAvatar">?</div>
      <span id="hdrName">Guest</span>
    </div>
  </div>
</header>

<div class="layout">
  <nav class="sidebar">
    <div class="sb-sec">
      <div class="sb-lbl">Menu</div>
      <div class="sb-item active" id="sb-home" onclick="showPage('home')">🏠 Home</div>
      <div class="sb-item" id="sb-leaderboard" onclick="showPage('leaderboard')">🏆 Leaderboard</div>
      <div class="sb-item" id="sb-resources" onclick="showPage('resources')">📁 Resources</div>
    </div>
    <div class="sb-sec">
      <div class="sb-lbl">Subjects</div>
      <div class="sb-item" id="sb-geometry" onclick="showPage('geometry')"><span class="sb-dot" style="background:#4f8fff"></span> Geometry With Proof</div>
      <div class="sb-item" id="sb-algebra2" onclick="showPage('algebra2')"><span class="sb-dot" style="background:#9f6fff"></span> Algebra 2</div>
      <div class="sb-item" id="sb-worldciv2" onclick="showPage('worldciv2')"><span class="sb-dot" style="background:#ff8c42"></span> World Civilizations II</div>
      <div class="sb-item" id="sb-english10" onclick="showPage('english10')"><span class="sb-dot" style="background:#2fffc8"></span> English 10</div>
      <div class="sb-item" id="sb-science10" onclick="showPage('science10')"><span class="sb-dot" style="background:#ff4f4f"></span> Science 10</div>
      <div class="sb-item" id="sb-french4" onclick="showPage('french4')"><span class="sb-dot" style="background:#d4f14a"></span> French 4</div>
    </div>
    <div class="sb-bottom">
      <div class="sb-user">
        <div class="avatar" id="sbAvatar" style="width:32px;height:32px;font-size:13px">?</div>
        <div class="sb-user-info">
          <div class="sb-user-name" id="sbName">Guest</div>
          <div class="sb-user-sub">Click header to change</div>
        </div>
      </div>
    </div>
  </nav>

  <div class="main-area">

    <!-- HOME -->
    <div class="page active" id="page-home">
      <div class="inner">
        <div class="home-hero">
          <h1>Study smarter,<br><em>not harder.</em></h1>
          <p>AI-generated quizzes from your class notes, live leaderboards, flashcards, notes and a Pomodoro timer — everything for your 6 classes in one place.</p>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="btn btn-lime btn-lg" onclick="showPage('leaderboard')">🏆 Leaderboard</button>
            <button class="btn btn-lg" onclick="showPage('geometry')">Start studying →</button>
          </div>
        </div>
        <div class="sec-hdr"><h2 class="sec-title">Your Classes</h2></div>
        <div class="subj-grid">
          <div class="subj-card" style="--c:rgba(79,143,255,0.1)" onclick="showPage('geometry')"><span class="sc-icon">📐</span><div class="sc-name">Geometry With Proof</div><div class="sc-desc">Two-column proofs, theorems, congruence, similarity and circle geometry</div><span class="sc-arrow">→</span></div>
          <div class="subj-card" style="--c:rgba(159,111,255,0.1)" onclick="showPage('algebra2')"><span class="sc-icon">🔣</span><div class="sc-name">Algebra 2</div><div class="sc-desc">Polynomials, functions, logarithms, complex numbers and conic sections</div><span class="sc-arrow">→</span></div>
          <div class="subj-card" style="--c:rgba(255,140,66,0.1)" onclick="showPage('worldciv2')"><span class="sc-icon">🌍</span><div class="sc-name">World Civilizations II</div><div class="sc-desc">Renaissance to present day — revolutions, world wars and modern geopolitics</div><span class="sc-arrow">→</span></div>
          <div class="subj-card" style="--c:rgba(47,255,200,0.1)" onclick="showPage('english10')"><span class="sc-icon">📖</span><div class="sc-name">English 10</div><div class="sc-desc">Literary analysis, rhetoric, writing craft and close reading skills</div><span class="sc-arrow">→</span></div>
          <div class="subj-card" style="--c:rgba(255,79,79,0.1)" onclick="showPage('science10')"><span class="sc-icon">🔬</span><div class="sc-name">Science 10</div><div class="sc-desc">Chemistry, biology and physics fundamentals for 10th grade</div><span class="sc-arrow">→</span></div>
          <div class="subj-card" style="--c:rgba(212,241,74,0.1)" onclick="showPage('french4')"><span class="sc-icon">🗣️</span><div class="sc-name">French 4</div><div class="sc-desc">Advanced grammar, literature, composition and spoken French</div><span class="sc-arrow">→</span></div>
        </div>
        <div class="sec-hdr"><h2 class="sec-title">Quick access</h2></div>
        <div class="quick-grid">
          <div class="quick-card" onclick="showPage('leaderboard')"><div class="qc-icon">🏆</div><div class="qc-label">Leaderboard</div></div>
          <div class="quick-card" onclick="showPage('resources')"><div class="qc-icon">📁</div><div class="qc-label">Resources</div></div>
          <div class="quick-card" onclick="showPage('geometry');setTimeout(()=>switchTab('geometry','timer'),200)"><div class="qc-icon">⏱</div><div class="qc-label">Pomodoro Timer</div></div>
          <div class="quick-card" onclick="showPage('geometry');setTimeout(()=>switchTab('geometry','flashcards'),200)"><div class="qc-icon">🃏</div><div class="qc-label">Flashcards</div></div>
        </div>
      </div>
    </div>

    <!-- LEADERBOARD -->
    <div class="page" id="page-leaderboard">
      <div class="inner">
        <div class="sec-hdr"><h2 class="sec-title">🏆 Leaderboard</h2><button class="btn" onclick="renderLB()">↺ Refresh</button></div>
        <div class="lb-filter">
          <button class="lb-f-btn active" onclick="filterLB('all',this)">All classes</button>
          <button class="lb-f-btn" onclick="filterLB('geometry',this)">Geometry</button>
          <button class="lb-f-btn" onclick="filterLB('algebra2',this)">Algebra 2</button>
          <button class="lb-f-btn" onclick="filterLB('worldciv2',this)">World Civ II</button>
          <button class="lb-f-btn" onclick="filterLB('english10',this)">English 10</button>
          <button class="lb-f-btn" onclick="filterLB('science10',this)">Science 10</button>
          <button class="lb-f-btn" onclick="filterLB('french4',this)">French 4</button>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <table><thead><tr><th>Rank</th><th>Student</th><th>Class</th><th>Score</th><th>Q's</th><th>Date</th></tr></thead>
          <tbody id="lbBody"></tbody></table>
          <div id="lbEmpty" style="display:none;padding:3rem;text-align:center;color:var(--mu);font-size:13px">No scores yet — complete a quiz to appear here! 🎯</div>
        </div>
      </div>
    </div>

    <!-- RESOURCES -->
    <div class="page" id="page-resources">
      <div class="inner">
        <div class="sec-hdr"><h2 class="sec-title">📁 Resources</h2><span style="font-size:12px;color:var(--mu)">Stored in your browser</span></div>
        <div class="card" style="margin-bottom:1rem">
          <div class="upload-zone">
            <input type="file" multiple accept=".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg,.pptx" onchange="handleUpload(this)"/>
            <div style="font-size:2.5rem;margin-bottom:0.75rem">📤</div>
            <h3 style="font-family:var(--ff);font-size:1.1rem;font-weight:600;margin-bottom:4px">Upload study materials</h3>
            <p style="font-size:12px;color:var(--mu)">Drag & drop or click to browse · PDF, Word, PowerPoint, images, text</p>
          </div>
        </div>
        <div id="fileList"></div>
        <p id="noFiles" style="text-align:center;padding:2rem;color:var(--mu);font-size:13px">No files uploaded yet!</p>
      </div>
    </div>

    <!-- SUBJECT PAGES -->
    <div class="page" id="page-geometry"></div>
    <div class="page" id="page-algebra2"></div>
    <div class="page" id="page-worldciv2"></div>
    <div class="page" id="page-english10"></div>
    <div class="page" id="page-science10"></div>
    <div class="page" id="page-french4"></div>

  </div>
</div>

<script>
const ADMIN_PASSWORD = 'studyhub2024';

const SUBJECTS = {
  geometry:{
    name:'Geometry With Proof', icon:'📐', color:'#4f8fff',
    summary:'Master two-column proofs — every statement needs a reason. Key topics: congruence (SSS, SAS, ASA, AAS, HL), similarity (AA, SSS, SAS), parallel lines and transversals, triangle theorems, quadrilateral properties, circle theorems (inscribed angles, central angles, arc length, sector area), and coordinate geometry. Always start a proof by listing what\'s given and what you need to prove.',
    defaultCards:[
      {q:'What does SSS stand for in triangle congruence?', a:'Side-Side-Side — if all three sides of one triangle are congruent to all three sides of another, the triangles are congruent'},
      {q:'What is the Triangle Angle Sum Theorem?', a:'The sum of the interior angles of any triangle equals 180°'},
      {q:'What is an inscribed angle?', a:'An angle formed by two chords that share an endpoint ON the circle. It equals half the intercepted arc'},
      {q:'What are alternate interior angles?', a:'Angles on opposite sides of a transversal between two parallel lines — they are always congruent'},
      {q:'What is the Pythagorean Theorem?', a:'a² + b² = c², where c is the hypotenuse of a right triangle'},
    ]
  },
  algebra2:{
    name:'Algebra 2', icon:'🔣', color:'#9f6fff',
    summary:'Build on Algebra 1 with more complex functions and equations. Key topics: polynomial operations and factoring, quadratic functions (vertex form, standard form, discriminant), complex numbers (i = √−1), exponential and logarithmic functions (log laws, natural log), rational functions and asymptotes, sequences and series (arithmetic and geometric), and an introduction to conic sections (parabola, circle, ellipse, hyperbola).',
    defaultCards:[
      {q:'What is the quadratic formula?', a:'x = (−b ± √(b²−4ac)) / 2a — used to solve ax² + bx + c = 0'},
      {q:'What does the discriminant tell you?', a:'b²−4ac: if > 0 → two real solutions; = 0 → one real solution; < 0 → two complex solutions'},
      {q:'What is i (imaginary unit)?', a:'i = √(−1), so i² = −1'},
      {q:'What is the change of base formula?', a:'log_b(x) = log(x) / log(b) — converts to any base'},
      {q:'What is a geometric sequence?', a:'A sequence where each term is multiplied by a constant ratio r. Formula: a_n = a₁ · r^(n−1)'},
    ]
  },
  worldciv2:{
    name:'World Civilizations II', icon:'🌍', color:'#ff8c42',
    summary:'Covering the Renaissance (c.1300) to the present. Key themes: Renaissance and Reformation, Age of Exploration, Scientific Revolution, Enlightenment, Atlantic Revolutions (American, French, Haitian), Industrial Revolution, imperialism and nationalism, World War I, the interwar period, World War II, the Cold War, decolonisation, and globalisation. Focus on causes, consequences and connections between events.',
    defaultCards:[
      {q:'What triggered World War I?', a:'The assassination of Archduke Franz Ferdinand (1914), combined with militarism, alliances, imperialism and nationalism (MAIN)'},
      {q:'What was the Enlightenment?', a:'An 18th-century intellectual movement emphasising reason, individual rights and scientific thinking — influenced the American and French Revolutions'},
      {q:'What was the policy of appeasement?', a:'Giving in to an aggressor\'s demands to avoid conflict — used by Britain/France toward Hitler in the 1930s, most notably at Munich (1938)'},
      {q:'What were the main causes of World War II?', a:'Harsh Treaty of Versailles, Great Depression, rise of fascism/Nazism, failure of appeasement, and Hitler\'s expansionist aggression'},
      {q:'What was the Cold War?', a:'A geopolitical tension (1947–1991) between the USA (capitalism) and USSR (communism) — fought through proxy wars, arms races and ideology rather than direct combat'},
    ]
  },
  english10:{
    name:'English 10', icon:'📖', color:'#2fffc8',
    summary:'Develop skills in literary analysis, argumentative writing and close reading. When analysing texts, use TIQA (Topic sentence, Introduce evidence, Quote/cite, Analyse). Always discuss the author\'s purpose and effect on the reader. Key literary devices: metaphor, simile, personification, imagery, irony (verbal, situational, dramatic), symbolism, theme, tone, diction, syntax and narrative perspective.',
    defaultCards:[
      {q:'What is dramatic irony?', a:'When the audience/reader knows something that a character does not — creates tension or humour'},
      {q:'What is the TIQA structure?', a:'Topic sentence → Introduce evidence → Quote/cite → Analyse the effect'},
      {q:'What is the difference between theme and topic?', a:'Topic is the subject (e.g. war). Theme is the message or insight about that subject (e.g. "War destroys innocence")'},
      {q:'What is an unreliable narrator?', a:'A narrator whose credibility is compromised — due to bias, limited knowledge, or dishonesty. Requires the reader to read between the lines'},
      {q:'What is syntax?', a:'The arrangement of words and phrases to create meaning. Sentence structure, length and punctuation all contribute to tone and effect'},
    ]
  },
  science10:{
    name:'Science 10', icon:'🔬', color:'#ff4f4f',
    summary:'A broad overview across the three sciences. Chemistry: atomic structure, periodic table trends, chemical bonding (ionic, covalent, metallic), chemical reactions and balancing equations, acids and bases. Biology: cell structure and function, DNA and genetics (Punnett squares, dominant/recessive), ecosystems and energy flow. Physics: motion (speed, velocity, acceleration), Newton\'s laws, energy types and conservation, waves.',
    defaultCards:[
      {q:'What is the difference between ionic and covalent bonding?', a:'Ionic: electrons transferred between metal and non-metal. Covalent: electrons shared between two non-metals'},
      {q:'What is Newton\'s second law?', a:'F = ma — Force equals mass times acceleration'},
      {q:"What is Mendel's law of segregation?", a:'Each organism has two alleles for each trait; they separate during reproduction so offspring receive one from each parent'},
      {q:'What is the law of conservation of energy?', a:'Energy cannot be created or destroyed — only converted from one form to another'},
      {q:'What does pH measure?', a:'The acidity or alkalinity of a solution. pH < 7 = acidic, pH = 7 = neutral, pH > 7 = alkaline/basic'},
    ]
  },
  french4:{
    name:'French 4', icon:'🗣️', color:'#d4f14a',
    summary:'Advanced French building on three years of study. Focus areas: the subjunctive mood (when to use it and how to conjugate), complex tenses (conditionnel passé, plus-que-parfait), sophisticated connectives and discourse markers, literary analysis of French texts, essay writing in French, and expanding vocabulary for abstract discussions (society, environment, technology, culture). Precision in grammar and elegance in expression are the goals.',
    defaultCards:[
      {q:'When do you use the subjunctive?', a:'After expressions of doubt, emotion, wish, necessity, or certain conjunctions (bien que, pour que, à moins que, avant que)'},
      {q:'How do you form the conditionnel passé?', a:'Conditional of avoir/être + past participle — e.g. "j\'aurais mangé" (I would have eaten)'},
      {q:'What is the plus-que-parfait?', a:'The pluperfect — imparfait of avoir/être + past participle. Expresses an action completed before another past action: "j\'avais déjà mangé quand il est arrivé"'},
      {q:'What does "bien que" take?', a:'The subjunctive — e.g. "Bien qu\'il soit tard, je reste" (Although it is late, I am staying)'},
      {q:'What is the difference between "depuis" and "il y a"?', a:'"Depuis" = ongoing action still happening ("J\'étudie depuis une heure"). "Il y a" = completed action in the past ("Il y a une heure, j\'ai commencé")'},
    ]
  }
};

// STATE
let currentUser = localStorage.getItem('sh_user')||'';
let isAdmin = false;
let lbSubjFilter = 'all';
let scores = JSON.parse(localStorage.getItem('sh_scores')||'[]');
let uploadedFiles = JSON.parse(localStorage.getItem('sh_files')||'[]');
let notesData = JSON.parse(localStorage.getItem('sh_notes')||'{}');
let qBanks = JSON.parse(localStorage.getItem('sh_qbanks')||'{}');
let fcDecks = JSON.parse(localStorage.getItem('sh_fcdecks')||'{}');
const fcState={}, qState={}, tmState={}, tmIntervals={};
const TCIRC=283, Q_LETTERS=['A','B','C','D'], Q_TIME=30;

// USER
function setUser(){const v=document.getElementById('userIn').value.trim();if(!v)return;currentUser=v;localStorage.setItem('sh_user',v);updateUserUI();document.getElementById('userOverlay').classList.add('hidden');}
function updateUserUI(){const a=currentUser?currentUser[0].toUpperCase():'?';['hdrAvatar','sbAvatar'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=a;});['hdrName','sbName'].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=currentUser||'Guest';});}
document.getElementById('userIn').addEventListener('keydown',e=>{if(e.key==='Enter')setUser();});
if(currentUser){updateUserUI();document.getElementById('userOverlay').classList.add('hidden');}

// ADMIN
function toggleAdmin(){if(isAdmin){isAdmin=false;updateAdminUI();return;}document.getElementById('adminOverlay').classList.remove('hidden');setTimeout(()=>document.getElementById('adminPassIn').focus(),100);}
function checkAdmin(){if(document.getElementById('adminPassIn').value===ADMIN_PASSWORD){isAdmin=true;closeAdminOverlay();updateAdminUI();rebuildAll();}else{document.getElementById('adminErr').style.display='block';}}
function closeAdminOverlay(){document.getElementById('adminOverlay').classList.add('hidden');document.getElementById('adminPassIn').value='';document.getElementById('adminErr').style.display='none';}
function updateAdminUI(){const btn=document.getElementById('adminBtn'),txt=document.getElementById('adminBtnTxt');if(isAdmin){btn.classList.add('on');txt.textContent='Admin ON';}else{btn.classList.remove('on');txt.textContent='Admin';}rebuildAll();}
document.getElementById('adminPassIn').addEventListener('keydown',e=>{if(e.key==='Enter')checkAdmin();});

// NAV
function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.sb-item').forEach(n=>n.classList.remove('active'));document.getElementById('page-'+id).classList.add('active');const sb=document.getElementById('sb-'+id);if(sb)sb.classList.add('active');if(id==='leaderboard')renderLB();if(id==='resources')renderFiles();}
function switchTab(subj,tab){['flashcards','quiz','notes','timer'].forEach(t=>{const btn=document.getElementById(`${subj}-tbtn-${t}`);const pane=document.getElementById(`${subj}-pane-${t}`);if(btn)btn.classList.remove('active');if(pane)pane.classList.remove('active');});const ab=document.getElementById(`${subj}-tbtn-${tab}`);const ap=document.getElementById(`${subj}-pane-${tab}`);if(ab)ab.classList.add('active');if(ap)ap.classList.add('active');}

