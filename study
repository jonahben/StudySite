      <button class="btn btn-orange btn-lg" onclick="checkAdmin()">Unlock</button>
      <button class="btn btn-lg" onclick="closeAdminOverlay()">Cancel</button>
    </div>
    <p id="adminErr" style="color:var(--red);font-size:12px;margin-top:10px;display:none">Incorrect password. Try again.</p>
