<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>StudyHub</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Satoshi:wght@300;400;500;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#070709;--s1:#0f0f13;--s2:#17171d;--s3:#1f1f27;--s4:#27272f;
  --b1:rgba(255,255,255,0.06);--b2:rgba(255,255,255,0.11);--b3:rgba(255,255,255,0.18);
  --tx:#f2ede6;--mu:#6e6a7c;--fa:#2e2c3a;
  --lime:#d4f14a;--lime2:#a8c032;--limeg:rgba(212,241,74,0.1);
  --teal:#2fffc8;--red:#ff4f4f;--blue:#4f8fff;--purple:#9f6fff;--orange:#ff8c42;
  --r:8px;--r2:14px;--r3:20px;--r4:28px;
  --ff:'Clash Display',sans-serif;--fb:'Satoshi',sans-serif;
  --ease:cubic-bezier(.4,0,.2,1);
}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--tx);font-family:var(--fb);font-size:14px;line-height:1.6;min-height:100vh;overflow-x:hidden}
body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");pointer-events:none;z-index:9999;opacity:0.5}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--b3);border-radius:2px}

.overlay{position:fixed;inset:0;background:rgba(7,7,9,0.92);backdrop-filter:blur(12px);z-index:500;display:flex;align-items:center;justify-content:center;padding:1rem}
.overlay.hidden{display:none}
.modal{background:var(--s1);border:1px solid var(--b2);border-radius:var(--r4);padding:2.5rem;width:min(440px,100%);text-align:center;animation:popIn 0.3s var(--ease)}
@keyframes popIn{from{opacity:0;transform:scale(0.94)}to{opacity:1;transform:scale(1)}}
.modal-icon{font-size:3rem;margin-bottom:1rem;display:block}
.modal h2{font-family:var(--ff);font-size:1.8rem;font-weight:700;letter-spacing:-0.02em;margin-bottom:0.5rem}
.modal p{color:var(--mu);font-size:13px;margin-bottom:1.5rem;line-height:1.6}
.modal-input{width:100%;background:var(--s2);border:1px solid var(--b2);color:var(--tx);font-family:var(--fb);font-size:15px;padding:13px 16px;border-radius:var(--r2);outline:none;transition:border-color 0.2s;text-align:center;margin-bottom:12px}
.modal-input:focus{border-color:var(--lime)}

header{position:sticky;top:0;z-index:100;background:rgba(7,7,9,0.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--b1)}
.hdr{max-width:1280px;margin:0 auto;padding:0 1.5rem;height:58px;display:flex;align-items:center;gap:12px}
.logo{font-family:var(--ff);font-size:1.4rem;font-weight:700;color:var(--lime);text-decoration:none;letter-spacing:-0.03em;margin-right:auto;cursor:pointer}
.logo span{color:var(--tx);font-weight:400}
.hdr-pill{display:flex;align-items:center;gap:8px;background:var(--s2);border:1px solid var(--b2);border-radius:999px;padding:5px 14px 5px 6px;cursor:pointer;transition:border-color 0.2s}
.hdr-pill:hover{border-color:var(--lime)}
.avatar{width:28px;height:28px;border-radius:50%;background:var(--lime);color:#070709;font-family:var(--ff);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.hdr-pill span{font-size:12px;font-weight:500}
.admin-btn{background:var(--s2);border:1px solid var(--b2);color:var(--mu);font-family:var(--fb);font-size:12px;font-weight:500;padding:6px 14px;border-radius:999px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:6px}
.admin-btn:hover{border-color:var(--orange);color:var(--orange)}
.admin-btn.on{border-color:var(--orange);color:var(--orange);background:rgba(255,140,66,0.08)}

.layout{display:flex;min-height:calc(100vh - 58px)}
.sidebar{width:240px;flex-shrink:0;background:var(--s1);border-right:1px solid var(--b1);padding:1.25rem 0;position:sticky;top:58px;height:calc(100vh - 58px);overflow-y:auto;display:flex;flex-direction:column}
.sb-sec{margin-bottom:1.25rem}
.sb-lbl{font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--fa);padding:0 1rem;margin-bottom:6px}
.sb-item{display:flex;align-items:center;gap:10px;padding:8px 1rem;cursor:pointer;color:var(--mu);font-size:13px;font-weight:500;border-left:2px solid transparent;transition:all 0.15s}
.sb-item:hover{color:var(--tx);background:var(--s2)}
.sb-item.active{color:var(--lime);border-left-color:var(--lime);background:var(--limeg)}
.sb-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.sb-bottom{margin-top:auto;padding:1rem;border-top:1px solid var(--b1)}
.sb-user{display:flex;align-items:center;gap:8px}
.sb-user-info{flex:1;min-width:0}
.sb-user-name{font-size:13px;font-weight:500;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-user-sub{font-size:11px;color:var(--mu)}

.main-area{flex:1;overflow-x:hidden}
.page{display:none}
.page.active{display:block;animation:fadeUp 0.25s var(--ease)}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.inner{max-width:980px;margin:0 auto;padding:2rem 1.5rem 5rem}

.btn{display:inline-flex;align-items:center;gap:6px;background:var(--s2);border:1px solid var(--b2);color:var(--mu);font-family:var(--fb);font-size:12px;font-weight:500;padding:7px 14px;border-radius:var(--r);cursor:pointer;transition:all 0.15s}
.btn:hover{color:var(--tx);border-color:var(--b3)}
.btn-lime{background:var(--lime);border-color:var(--lime);color:#070709;font-weight:700}
.btn-lime:hover{background:var(--lime2);border-color:var(--lime2);color:#070709}
.btn-orange{background:rgba(255,140,66,0.12);border-color:rgba(255,140,66,0.3);color:var(--orange)}
.btn-orange:hover{background:rgba(255,140,66,0.2)}
.btn-red{background:rgba(255,79,79,0.1);border-color:rgba(255,79,79,0.3);color:var(--red)}
.btn-red:hover{background:rgba(255,79,79,0.18)}
.btn-lg{padding:12px 24px;font-size:14px;border-radius:var(--r2)}
.btn-block{width:100%;justify-content:center}
.btn-sm{padding:5px 10px;font-size:11px}

.card{background:var(--s1);border:1px solid var(--b1);border-radius:var(--r3);padding:1.25rem}
.card2{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r2);padding:1rem}

label{font-size:11px;font-weight:600;letter-spacing:0.07em;text-transform:uppercase;color:var(--mu);display:block;margin-bottom:5px}
input[type=text],input[type=password],input[type=number],textarea,select{width:100%;background:var(--s2);border:1px solid var(--b2);color:var(--tx);font-family:var(--fb);font-size:13px;padding:9px 12px;border-radius:var(--r);outline:none;transition:border-color 0.2s}
input:focus,textarea:focus,select:focus{border-color:var(--lime)}
textarea{resize:vertical;min-height:80px;line-height:1.6}
.form-row{margin-bottom:12px}
.divider{border:none;border-top:1px solid var(--b1);margin:1rem 0}

.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;flex-wrap:wrap;gap:8px}
.sec-title{font-family:var(--ff);font-size:1.5rem;font-weight:700;letter-spacing:-0.02em}

.tab-bar{display:flex;gap:3px;background:var(--s2);padding:3px;border-radius:var(--r2);margin-bottom:1.5rem;flex-wrap:wrap}
.tab-btn{flex:1;background:none;border:none;color:var(--mu);font-family:var(--fb);font-size:12px;font-weight:500;padding:8px 10px;border-radius:10px;cursor:pointer;transition:all 0.15s;white-space:nowrap;display:flex;align-items:center;justify-content:center;gap:5px}
.tab-btn.active{background:var(--s3);color:var(--tx)}
.tab-pane{display:none}
.tab-pane.active{display:block;animation:fadeUp 0.2s var(--ease)}

.home-hero{padding:3.5rem 0 2.5rem;border-bottom:1px solid var(--b1);margin-bottom:2rem}
.home-hero h1{font-family:var(--ff);font-size:clamp(2.2rem,5vw,3.4rem);font-weight:700;letter-spacing:-0.03em;line-height:1.05;margin-bottom:0.75rem}
.home-hero h1 em{color:var(--lime);font-style:italic}
.home-hero p{color:var(--mu);font-size:14px;max-width:480px;margin-bottom:1.5rem}
.subj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;margin-bottom:2.5rem}
.subj-card{background:var(--s1);border:1px solid var(--b1);border-radius:var(--r3);padding:1.5rem;cursor:pointer;transition:all 0.2s;position:relative;overflow:hidden}
.subj-card::before{content:'';position:absolute;inset:0;opacity:0;transition:opacity 0.2s;background:radial-gradient(circle at top left,var(--c,var(--limeg)),transparent 70%)}
.subj-card:hover{border-color:var(--b2);transform:translateY(-2px)}
.subj-card:hover::before{opacity:1}
.sc-icon{font-size:2rem;margin-bottom:0.75rem;display:block}
.sc-name{font-family:var(--ff);font-size:1rem;font-weight:600;margin-bottom:4px}
.sc-desc{font-size:12px;color:var(--mu);line-height:1.5}
.sc-arrow{font-size:18px;color:var(--fa);margin-top:10px;display:block}
.quick-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
.quick-card{background:var(--s1);border:1px solid var(--b1);border-radius:var(--r2);padding:1rem;cursor:pointer;transition:all 0.15s;text-align:center}
.quick-card:hover{border-color:var(--b2);background:var(--s2)}
.qc-icon{font-size:1.5rem;margin-bottom:6px}
.qc-label{font-size:12px;font-weight:500;color:var(--mu)}

.subj-hdr{display:flex;align-items:center;gap:14px;padding:2rem 0 1.5rem;border-bottom:1px solid var(--b1);margin-bottom:1.5rem}
.subj-hdr-icon{font-size:3rem}
.subj-hdr h1{font-family:var(--ff);font-size:1.8rem;font-weight:700;letter-spacing:-0.02em}
.subj-hdr p{font-size:13px;color:var(--mu)}
.summary-card{border-left:3px solid var(--subj-color,var(--lime));border-radius:0 var(--r2) var(--r2) 0;background:var(--s2);padding:1rem 1.25rem;margin-bottom:1.5rem;font-size:13px;color:var(--mu);line-height:1.7}
.summary-card strong{color:var(--tx)}

.fc-layout{display:grid;grid-template-columns:1fr 260px;gap:1rem}
.flip-scene{perspective:1000px;height:230px;cursor:pointer;margin-bottom:8px}
.flip-inner{width:100%;height:100%;position:relative;transform-style:preserve-3d;transition:transform 0.5s var(--ease);border-radius:var(--r3)}
.flip-inner.flipped{transform:rotateY(180deg)}
.flip-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:var(--r3);background:var(--s2);border:1px solid var(--b2);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:1.5rem;text-align:center}
.flip-back{transform:rotateY(180deg);background:var(--s1)}
.flip-lbl{font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--fa);margin-bottom:0.75rem}
.flip-txt{font-family:var(--ff);font-size:1.15rem;font-weight:600;line-height:1.4;color:var(--tx)}
.flip-hint{font-size:11px;color:var(--fa);text-align:center;margin-bottom:10px}
.fc-ctrl{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:1.25rem}
.icon-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--b2);background:var(--s2);color:var(--mu);cursor:pointer;font-size:15px;display:flex;align-items:center;justify-content:center;transition:all 0.15s}
.icon-btn:hover{color:var(--tx);border-color:var(--b3)}
.fc-count{font-size:12px;color:var(--mu);min-width:50px;text-align:center}
.fc-deck{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r2);padding:1rem}
.deck-label{font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--fa);margin-bottom:8px}
.deck-list{max-height:220px;overflow-y:auto;display:flex;flex-direction:column;gap:4px}
.deck-item{background:var(--s3);border:1px solid var(--b1);border-radius:var(--r);padding:7px 10px;font-size:12px;color:var(--mu);cursor:pointer;transition:all 0.15s;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.deck-item:hover,.deck-item.active{border-color:var(--lime);color:var(--tx)}

.quiz-layout{display:grid;grid-template-columns:1fr 230px;gap:1rem}
.q-prog-wrap{height:3px;background:var(--s3);border-radius:2px;margin-bottom:1rem;overflow:hidden}
.q-prog{height:100%;background:var(--lime);border-radius:2px;transition:width 0.4s var(--ease)}
.q-timer-bar-wrap{height:4px;background:var(--s3);border-radius:2px;margin-bottom:1.25rem;overflow:hidden}
.q-timer-bar{height:100%;background:var(--lime);border-radius:2px;transition:width 1s linear}
.q-timer-bar.warn{background:var(--orange)}.q-timer-bar.danger{background:var(--red)}
.q-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem}
.q-num{font-size:11px;color:var(--fa)}
.q-timer-num{font-family:var(--ff);font-size:1rem;font-weight:600;color:var(--lime)}
.q-timer-num.warn{color:var(--orange)}.q-timer-num.danger{color:var(--red)}
.q-question{font-family:var(--ff);font-size:1.1rem;font-weight:600;line-height:1.4;margin-bottom:1.25rem}
.q-opts{display:flex;flex-direction:column;gap:8px;margin-bottom:1rem}
.q-opt{background:var(--s2);border:1px solid var(--b1);color:var(--tx);font-family:var(--fb);font-size:13px;text-align:left;padding:11px 14px;border-radius:var(--r2);cursor:pointer;transition:all 0.15s;display:flex;align-items:center;gap:10px}
.q-opt-l{width:24px;height:24px;border-radius:6px;background:var(--s3);border:1px solid var(--b2);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--mu);flex-shrink:0;transition:all 0.15s}
.q-opt:hover:not(:disabled){border-color:var(--lime)}
.q-opt:hover:not(:disabled) .q-opt-l{background:var(--limeg);border-color:var(--lime);color:var(--lime)}
.q-opt.correct{border-color:var(--teal);background:rgba(47,255,200,0.06)}
.q-opt.correct .q-opt-l{background:rgba(47,255,200,0.15);border-color:var(--teal);color:var(--teal)}
.q-opt.wrong{border-color:var(--red);background:rgba(255,79,79,0.06)}
.q-opt.wrong .q-opt-l{background:rgba(255,79,79,0.15);border-color:var(--red);color:var(--red)}
.q-feedback{padding:10px 14px;border-radius:var(--r);font-size:13px;margin-bottom:10px;display:none}
.q-feedback.ok{background:rgba(47,255,200,0.08);border:1px solid rgba(47,255,200,0.25);color:var(--teal)}
.q-feedback.bad{background:rgba(255,79,79,0.08);border:1px solid rgba(255,79,79,0.25);color:var(--red)}
.score-panel{display:flex;flex-direction:column;gap:10px}
.score-big{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r2);padding:1.25rem;text-align:center}
.score-pct{font-family:var(--ff);font-size:3rem;font-weight:700;color:var(--lime);display:block;line-height:1}
.score-lbl{font-size:11px;color:var(--mu);margin-top:4px;display:block}
.score-mini{display:flex;gap:8px}
.score-box{flex:1;background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:10px;text-align:center}
.score-box .n{font-family:var(--ff);font-size:1.4rem;font-weight:700;display:block}
.score-box .l{font-size:11px;color:var(--mu)}
.c-n{color:var(--teal)}.w-n{color:var(--red)}
.no-quiz{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r3);padding:3rem;text-align:center}
.no-quiz-icon{font-size:3rem;margin-bottom:1rem;display:block}
.no-quiz h3{font-family:var(--ff);font-size:1.2rem;font-weight:600;margin-bottom:0.5rem}
.no-quiz p{font-size:13px;color:var(--mu);line-height:1.6;margin-bottom:0.75rem}

.result-screen{text-align:center;padding:3rem 1rem}
.result-score{font-family:var(--ff);font-size:5rem;font-weight:700;letter-spacing:-0.04em;line-height:1;margin-bottom:0.5rem}
.result-grade{display:inline-block;padding:4px 16px;border-radius:999px;font-size:13px;font-weight:600;margin-bottom:1rem}
.result-msg{font-size:14px;color:var(--mu);margin-bottom:2rem;line-height:1.6}
.result-breakdown{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:2rem;max-width:360px;margin-left:auto;margin-right:auto}
.rb-item{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r2);padding:1rem}
.rb-n{font-family:var(--ff);font-size:1.8rem;font-weight:700;display:block}
.rb-l{font-size:11px;color:var(--mu)}
.result-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}

.notes-layout{display:grid;grid-template-columns:1fr 220px;gap:1rem}
.n-toolbar{display:flex;gap:4px;flex-wrap:wrap;padding:6px;background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);margin-bottom:8px}
.n-tb-btn{background:none;border:1px solid transparent;color:var(--mu);font-family:var(--fb);font-size:12px;font-weight:600;padding:4px 9px;border-radius:5px;cursor:pointer;transition:all 0.15s}
.n-tb-btn:hover{background:var(--s3);color:var(--tx);border-color:var(--b1)}
.n-ta{width:100%;min-height:340px;background:var(--s2);border:1px solid var(--b1);color:var(--tx);font-family:var(--fb);font-size:14px;line-height:1.8;padding:1rem 1.25rem;border-radius:var(--r2);outline:none;transition:border-color 0.2s;resize:vertical}
.n-ta:focus{border-color:var(--lime)}
.n-meta{font-size:11px;color:var(--fa);margin-top:6px}
.n-saved-item{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:10px;cursor:pointer;transition:all 0.15s;margin-bottom:6px}
.n-saved-item:hover{border-color:var(--b2)}
.n-saved-title{font-size:12px;font-weight:500;color:var(--tx);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:2px}
.n-saved-date{font-size:10px;color:var(--fa)}

.timer-layout{display:grid;grid-template-columns:260px 1fr;gap:1rem;align-items:start}
.timer-card{background:var(--s1);border:1px solid var(--b1);border-radius:var(--r3);padding:1.5rem;text-align:center}
.mode-row{display:flex;gap:3px;background:var(--s2);padding:3px;border-radius:var(--r);margin-bottom:1.25rem}
.mode-btn{flex:1;background:none;border:none;color:var(--mu);font-family:var(--fb);font-size:11px;font-weight:500;padding:6px 4px;border-radius:6px;cursor:pointer;transition:all 0.15s}
.mode-btn.active{background:var(--s3);color:var(--tx)}
.timer-face{position:relative;width:160px;height:160px;margin:0 auto 1.25rem}
.t-svg{transform:rotate(-90deg);width:100%;height:100%}
.t-bg{fill:none;stroke:var(--s3);stroke-width:5}
.t-ring{fill:none;stroke:var(--lime);stroke-width:5;stroke-linecap:round;transition:stroke-dashoffset 1s linear}
.t-num{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--ff);font-size:2.4rem;font-weight:700;letter-spacing:-0.03em;color:var(--tx)}
.t-btns{display:flex;gap:8px;justify-content:center;margin-bottom:1rem}
.t-main-btn{background:var(--lime);border:none;color:#070709;font-family:var(--fb);font-size:14px;font-weight:700;padding:10px 24px;border-radius:var(--r);cursor:pointer;transition:all 0.15s}
.t-main-btn:hover{background:var(--lime2)}
.t-reset-btn{background:var(--s2);border:1px solid var(--b2);color:var(--mu);font-family:var(--fb);font-size:14px;padding:10px 16px;border-radius:var(--r);cursor:pointer;transition:all 0.15s}
.t-reset-btn:hover{color:var(--tx)}
.t-pips{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-top:8px}
.t-pip{aspect-ratio:1;border-radius:50%;background:var(--s3);border:1px solid var(--b1);transition:all 0.3s}
.t-pip.done{background:var(--lime);border-color:var(--lime)}
.t-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:1rem}
.t-stat{background:var(--s1);border:1px solid var(--b1);border-radius:var(--r);padding:0.75rem;text-align:center}
.t-stat-n{font-family:var(--ff);font-size:1.8rem;font-weight:700;color:var(--lime);display:block}
.t-stat-l{font-size:11px;color:var(--mu)}

.lb-filter{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:1rem}
.lb-f-btn{background:var(--s2);border:1px solid var(--b1);color:var(--mu);font-family:var(--fb);font-size:11px;font-weight:500;padding:5px 12px;border-radius:999px;cursor:pointer;transition:all 0.15s}
.lb-f-btn:hover,.lb-f-btn.active{border-color:var(--lime);color:var(--lime);background:var(--limeg)}
table{width:100%;border-collapse:collapse}
th{font-size:10px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--fa);padding:10px 14px;text-align:left;border-bottom:1px solid var(--b1);background:var(--s2)}
td{padding:11px 14px;border-bottom:1px solid var(--b1);font-size:13px;color:var(--tx)}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,0.015)}
.rank-num{width:26px;height:26px;border-radius:6px;background:var(--s3);border:1px solid var(--b1);display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--mu)}
.rank-num.g{background:rgba(212,241,74,0.12);border-color:rgba(212,241,74,0.3);color:var(--lime)}
.rank-num.s{background:rgba(200,200,220,0.1);border-color:rgba(200,200,220,0.25);color:#c8c8dc}
.rank-num.b{background:rgba(205,127,50,0.12);border-color:rgba(205,127,50,0.3);color:#cd9050}
.you-row td{color:var(--lime)!important}.you-row{background:var(--limeg)!important}
.s-chip{font-size:11px;padding:2px 8px;border-radius:999px;font-weight:500}

.admin-panel{background:rgba(255,140,66,0.05);border:1px solid rgba(255,140,66,0.2);border-radius:var(--r3);padding:1.5rem;margin-bottom:1.5rem}
.admin-title{font-family:var(--ff);font-size:1rem;font-weight:600;color:var(--orange);margin-bottom:1rem;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.gen-status{padding:10px 14px;border-radius:var(--r);font-size:13px;margin-top:10px;display:none}
.gen-status.loading{background:var(--limeg);border:1px solid rgba(212,241,74,0.2);color:var(--lime)}
.gen-status.done{background:rgba(47,255,200,0.08);border:1px solid rgba(47,255,200,0.25);color:var(--teal)}
.gen-status.error{background:rgba(255,79,79,0.08);border:1px solid rgba(255,79,79,0.25);color:var(--red)}
.qb-preview{margin-top:1rem;display:flex;flex-direction:column;gap:5px;max-height:180px;overflow-y:auto}
.qb-item{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:8px 12px;font-size:12px;color:var(--mu)}
.qb-item strong{color:var(--tx);display:block;margin-bottom:2px;font-size:13px}
.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(212,241,74,0.3);border-top-color:var(--lime);border-radius:50%;animation:spin 0.7s linear infinite;vertical-align:middle;margin-right:6px}
@keyframes spin{to{transform:rotate(360deg)}}

.upload-zone{border:1.5px dashed var(--b2);border-radius:var(--r3);padding:2rem;text-align:center;cursor:pointer;transition:all 0.2s;position:relative}
.upload-zone:hover{border-color:var(--lime);background:var(--limeg)}
.upload-zone input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.file-item{background:var(--s2);border:1px solid var(--b1);border-radius:var(--r);padding:10px 14px;display:flex;align-items:center;gap:10px;margin-bottom:6px}
.file-del{background:none;border:none;color:var(--fa);cursor:pointer;font-size:18px;padding:2px 6px;border-radius:4px;transition:color 0.15s;margin-left:auto}
.file-del:hover{color:var(--red)}

@media(max-width:800px){.sidebar{display:none}.fc-layout,.quiz-layout,.notes-layout,.timer-layout{grid-template-columns:1fr}.subj-grid{grid-template-columns:1fr 1fr}}
@media(max-width:500px){.subj-grid{grid-template-columns:1fr}.tab-btn span.label{display:none}}
</style>
</head>
<body>

<!-- USERNAME MODAL -->
<div class="overlay" id="userOverlay">
  <div class="modal">
    <span class="modal-icon">📚</span>
    <h2>Welcome to StudyHub</h2>
    <p>Pick a username — it'll show on the leaderboard so you can compete with your class!</p>
    <input class="modal-input" id="userIn" type="text" placeholder="Your username…" maxlength="20"/>
    <button class="btn btn-lime btn-block btn-lg" onclick="setUser()">Start studying →</button>
  </div>
</div>

<!-- ADMIN MODAL -->
<div class="overlay hidden" id="adminOverlay">
  <div class="modal">
    <span class="modal-icon">🔐</span>
    <h2>Admin Access</h2>
    <p>Enter the admin password to manage question banks for each subject</p>
    <input class="modal-input" id="adminPassIn" type="password" placeholder="Password…"/>
